<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>
<configuration>

    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 过滤策略：PROMPT_LOG 只输出到控制台 -->
    <logger name="PROMPT_LOG" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 项目代码其他日志：只输出 ERROR 级别，屏蔽 DEBUG/INFO -->
    <logger name="com.example.app" level="ERROR"/>

    <!-- Hibernate 日志：全部屏蔽 -->
    <logger name="org.hibernate" level="OFF"/>
    <logger name="org.hibernate.SQL" level="OFF"/>
    <logger name="org.hibernate.type" level="OFF"/>
    <logger name="org.hibernate.orm" level="OFF"/>
    <logger name="org.hibernate.cfg" level="OFF"/>
    <logger name="org.hibernate.engine" level="OFF"/>
    <logger name="org.hibernate.hql" level="OFF"/>
    <logger name="org.hibernate.jpa" level="OFF"/>
    <logger name="org.hibernate.loader" level="OFF"/>
    <logger name="org.hibernate.persister" level="OFF"/>
    <logger name="org.hibernate.stat" level="OFF"/>

    <!-- 框架日志：只输出 WARN 级别 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="com.zaxxer" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

    <!-- 全局根日志：WARN -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>