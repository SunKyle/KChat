# ===============================
# KChat 前端环境变量示例 (.env.example)
# ===============================
# 复制此文件为 .env 或 .env.development / .env.production，
# Vite 会根据启动模式自动加载。以 VITE_ 开头的变量会被注入到客户端代码。

# -------------------------------
# 1. API 服务地址
# -------------------------------
# 后端 API 基础路径。
# - 开发环境下可留空，由 vite.config.ts 中的 /api 代理转发到 http://localhost:8080
# - 生产/独立部署时填写完整地址，例如 https://api.example.com/api
VITE_API_URL=http://localhost:8080/api

# -------------------------------
# 2. 普通 HTTP 请求参数（毫秒）
# -------------------------------
# 单次请求超时时间（默认 30s）
VITE_API_TIMEOUT=30000
# 请求失败最大重试次数（不含首次）
VITE_API_RETRIES=2
# 初始重试延迟（指数退避，第二次 = retryDelay * 2，以此类推）
VITE_API_RETRY_DELAY=1000

# -------------------------------
# 3. SSE（流式对话）请求参数（毫秒）
# -------------------------------
# SSE 请求超时，LLM 生成较慢时可适当放大（默认 60s）
VITE_SSE_TIMEOUT=60000

# -------------------------------
# 4. 本地存储（localStorage）前缀
# -------------------------------
# 当在同一域名下部署多套 KChat 前端时，更改此前缀可避免互相覆盖用户的 token 等数据
VITE_STORAGE_PREFIX=kchat_
